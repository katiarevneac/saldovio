# nestjs-zod@5.5.0's peer dependency range is "@nestjs/common": "^10.0.0 || ^11.0.0",
# which does not officially cover this project's ^12.0.1. In practice only
# createZodDto and ZodValidationPipe are used from nestjs-zod, both covered by
# 45+ passing tests and manual verification (Epic 7 S2). Remove this flag if/when
# nestjs-zod publishes a version whose peer range includes NestJS 12.
legacy-peer-deps=true
